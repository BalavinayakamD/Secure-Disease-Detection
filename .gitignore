# Data Files (TOO LARGE FOR GITHUB)
# Ignore all CSV files in data folders

data/raw/*.csv
data/raw/*.zip
data/raw/*.tar.gz
data/processed/*.csv
data/processed/*.pkl
data/processed/*.parquet
data/processed/*.npy

# keep .gitkeep files to track empty directories
!data/raw/.gitkeep
!data/processed/.gitkeep

# Outputs (TOO LARGE FOR GITHUB)
outputs/graphs/*.png
outputs/graphs/*.pdf
outputs/graphs/*.jpg
outputs/graphs/*.svg
outputs/logs/*.log
outputs/logs/*.txt
outputs/models/*.pth
outputs/models/*.pt
outputs/models/*.onnx
outputs/models/*.pkl

# Results JSON is small and SHOULD be committed -- only ignore stray files
!outputs/results/
!outputs/results/*.json

# keep .gitkeep files
!outputs/graphs/.gitkeep
!outputs/results/.gitkeep
!outputs/logs/.gitkeep
!outputs/models/.gitkeep

